#!/usr/bin/env bash
set -euo pipefail
FREEVIDEO_SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$FREEVIDEO_SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"

if [[ "$(uname -s)" == "Darwin" && "$(uname -m)" == "arm64" ]]; then
    FREEVIDEO_MACOS_PYTHON="$FREEVIDEO_SOURCE_DIR/.venv-macos/bin/python"
    if [[ ! -x "$FREEVIDEO_MACOS_PYTHON" ]]; then
        echo "FreeVideo: macOS environment is missing. Run ./setup_macos.sh first." >&2
        exit 1
    fi
    export PYTORCH_ENABLE_MPS_FALLBACK="${PYTORCH_ENABLE_MPS_FALLBACK:-1}"
    exec "$FREEVIDEO_MACOS_PYTHON" -B -X utf8 -m freevideo_engine "$@"
fi

source "$FREEVIDEO_SOURCE_DIR/scripts/bootstrap_linux.sh"
freevideo_bootstrap_linux cli "$@"
(( FREEVIDEO_BOOTSTRAP_DONE == 0 )) || exit 0
exec "$FREEVIDEO_BOOTSTRAP_PYTHON" -B -X utf8 -m freevideo_engine.managed "${FREEVIDEO_BOOTSTRAP_ARGS[@]}"
